{
  "widget": {
    "name": "Hiyuki Widget",
    "author": "thepenguin2703-hash",
    "version": "1.0.0",
    "sizes": [
      {"width": 2, "height": 2, "layout": "small"},
      {"width": 4, "height": 2, "layout": "wide"},
      {"width": 4, "height": 4, "layout": "large"}
    ],
    "background_color": "#F5F5F5",
    "text_color": "#000000",
    "accent_color": "#C41E3A",
    "border_color": "#E8A8B8",
    "features": {
      "character_display": true,
      "time_display": true,
      "weather_integration": true,
      "date_display": true,
      "custom_animations": true
    },
    "animations": {
      "idle": "hiyuki_breathing",
      "tap": "hiyuki_glow",
      "duration": 1000
    }
  }
}
