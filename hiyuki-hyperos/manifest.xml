<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <package>
    <name>hiyuki-hyperos</name>
    <version>1.0.0</version>
    <author>thepenguin2703-hash</author>
    <description>Hiyuki Theme for HyperOS 3.0.6</description>
  </package>
  
  <!-- Control Center Customization -->
  <control-center>
    <background-color>#F5F5F5</background-color>
    <icon-color>#C41E3A</icon-color>
    <toggle-on-color>#C41E3A</toggle-on-color>
    <toggle-off-color>#CCCCCC</toggle-off-color>
  </control-center>
  
  <!-- Lock Screen Customization -->
  <lock-screen>
    <background-color>#000000</background-color>
    <text-color>#FFFFFF</text-color>
    <accent-color>#C41E3A</accent-color>
  </lock-screen>
  
  <!-- Home Screen Customization -->
  <home-screen>
    <background-color>#FAFAF8</background-color>
    <icon-tint-color>#C41E3A</icon-tint-color>
    <widget-background-color>#FFFFFF</widget-background-color>
  </home-screen>
  
  <!-- Settings UI Customization -->
  <settings-ui>
    <header-background-color>#C41E3A</header-background-color>
    <header-text-color>#FFFFFF</header-text-color>
    <background-color>#FAFAF8</background-color>
    <text-primary-color>#000000</text-primary-color>
    <toggle-on-color>#C41E3A</toggle-on-color>
  </settings-ui>
  
  <!-- Game Turbo Customization -->
  <game-turbo>
    <interface-color>#C41E3A</interface-color>
    <background-color>#000000</background-color>
    <text-color>#FFFFFF</text-color>
    <transparency>0.9</transparency>
  </game-turbo>
</manifest>
